{"name":"worker","phase":"READ_APP_CONFIG","pid":221,"buildId":"15b2063b-4eb6-47fd-a5f7-da5dddb8fb6a","level":30,"msg":"{\n  \"name\": \"PhotogramBot\",\n  \"slug\": \"photogrambot\",\n  \"version\": \"1.2.0\",\n  \"scheme\": \"photogrambot\",\n  \"orientation\": \"portrait\",\n  \"icon\": \"./assets/icon.png\",\n  \"userInterfaceStyle\": \"automatic\",\n  \"backgroundColor\": \"#101014\",\n  \"ios\": {\n    \"supportsTablet\": true,\n    \"bundleIdentifier\": \"com.photogrambot.app\",\n    \"infoPlist\": {\n      \"NSPhotoLibraryUsageDescription\": \"PhotogramBot needs access to your photos to back them up to your Telegram channel.\",\n      \"NSPhotoLibraryAddUsageDescription\": \"PhotogramBot needs permission to save photos back to your library.\"\n    }\n  },\n  \"android\": {\n    \"package\": \"com.photogrambot.app\",\n    \"versionCode\": 4,\n    \"adaptiveIcon\": {\n      \"backgroundColor\": \"#101014\",\n      \"foregroundImage\": \"./assets/android-icon-foreground.png\",\n      \"backgroundImage\": \"./assets/android-icon-background.png\",\n      \"monochromeImage\": \"./assets/android-icon-monochrome.png\"\n    },\n    \"permissions\": [\n      \"android.permission.READ_MEDIA_IMAGES\",\n      \"android.permission.READ_MEDIA_VIDEO\",\n      \"android.permission.ACCESS_MEDIA_LOCATION\",\n      \"android.permission.READ_EXTERNAL_STORAGE\",\n      \"android.permission.CAMERA\",\n      \"android.permission.READ_EXTERNAL_STORAGE\",\n      \"android.permission.WRITE_EXTERNAL_STORAGE\",\n      \"android.permission.READ_MEDIA_VISUAL_USER_SELECTED\",\n      \"android.permission.READ_MEDIA_IMAGES\",\n      \"android.permission.READ_MEDIA_VIDEO\",\n      \"android.permission.READ_MEDIA_AUDIO\",\n      \"android.permission.RECORD_AUDIO\"\n    ],\n    \"predictiveBackGestureEnabled\": false,\n    \"intentFilters\": [\n      {\n        \"action\": \"SEND\",\n        \"category\": [\n          \"DEFAULT\"\n        ],\n        \"data\": [\n          {\n            \"mimeType\": \"image/*\"\n          },\n          {\n            \"mimeType\": \"video/*\"\n          }\n        ]\n      },\n      {\n        \"action\": \"SEND_MULTIPLE\",\n        \"category\": [\n          \"DEFAULT\"\n        ],\n        \"data\": [\n          {\n            \"mimeType\": \"image/*\"\n          },\n          {\n            \"mimeType\": \"video/*\"\n          }\n        ]\n      }\n    ]\n  },\n  \"web\": {\n    \"favicon\": \"./assets/favicon.png\"\n  },\n  \"runtimeVersion\": \"1.2.0\",\n  \"updates\": {\n    \"url\": \"https://u.expo.dev/421f1e6b-cda7-4f20-a6f1-dc972c76c0f4\",\n    \"enabled\": true,\n    \"checkAutomatically\": \"ON_LOAD\",\n    \"fallbackToCacheTimeout\": 0\n  },\n  \"extra\": {\n    \"eas\": {\n      \"projectId\": \"421f1e6b-cda7-4f20-a6f1-dc972c76c0f4\"\n    }\n  },\n  \"plugins\": [\n    [\n      \"expo-sqlite\",\n      {\n        \"useSQLCipher\": true\n      }\n    ],\n    \"expo-secure-store\",\n    \"expo-media-library\",\n    [\n      \"react-native-android-widget\",\n      {\n        \"widgets\": [\n          {\n            \"name\": \"RandomPhoto\",\n            \"label\": \"PhotogramBot\",\n            \"description\": \"Shows a random photo from your PhotogramBot gallery\",\n            \"minWidth\": \"180dp\",\n            \"minHeight\": \"180dp\",\n            \"resizeMode\": \"horizontal|vertical\",\n            \"updatePeriodMillis\": 21600000\n          },\n          {\n            \"name\": \"OnThisDay\",\n            \"label\": \"On this day\",\n            \"description\": \"A photo taken on today's date in an earlier year\",\n            \"minWidth\": \"180dp\",\n            \"minHeight\": \"180dp\",\n            \"resizeMode\": \"horizontal|vertical\",\n            \"updatePeriodMillis\": 86400000\n          },\n          {\n            \"name\": \"Mosaic\",\n            \"label\": \"Photo mosaic\",\n            \"description\": \"A 2x2 mosaic of photos from your archive\",\n            \"minWidth\": \"25
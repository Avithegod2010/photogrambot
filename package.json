{
  "name": "photogrambot",
  "version": "1.2.0",
  "description": "Back up your phone's photos and videos to your own Telegram channel via the Bot API — Google Photos-style app built with Expo + React Native.",
  "license": "MIT",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.32",
    "expo-background-task": "~57.0.22",
    "expo-battery": "~57.0.3",
    "expo-constants": "~57.0.23",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.21",
    "expo-file-system": "~57.0.5",
    "expo-image-manipulator": "~57.0.22",
    "expo-image-picker": "~57.0.21",
    "expo-local-authentication": "~57.0.3",
    "expo-media-library": "~57.0.6",
    "expo-network": "~57.0.3",
    "expo-notifications": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.25",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.22",
    "expo-updates": "~57.0.27",
    "expo-video": "~57.0.5",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.22.1",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-material-you": "^1.3.0",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "^0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node scripts/patch-remapping-types.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "test:e2e": "maestro test .maestro/smoke.yaml",
    "release:manifest": "node scripts/make-latest-json.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "release:resign": "node scripts/resign-apk.mjs",
    "release:check-signing": "node scripts/check-release-signing.mjs",
    "update:preview": "eas update --branch preview",
    "update:production": "eas update --branch production"
  },
  "overrides": {
    "shell-quote": "^1.12.0",
    "brace-expansion": "^5.0.12",
    "uuid": "^11.1.1"
  },
  "private": true
}
